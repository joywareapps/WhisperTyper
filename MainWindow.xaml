<Window x:Class="WhisperTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WhisperTyper" Height="800" Width="755"
        WindowStartupLocation="CenterScreen"
        Background="#0E0B16"
        Foreground="#F3F0FC"
        FontFamily="Segoe UI"
        BorderThickness="0"
        ResizeMode="CanMinimize"> <!-- Optional icon -->

    <Window.Resources>
        <!-- Custom Color Palette -->
        <Color x:Key="BgColor">#0E0B16</Color>
        <Color x:Key="PanelColor">#1A122E</Color>
        <Color x:Key="AccentColor">#8B5CF6</Color>
        <Color x:Key="MutedColor">#9E9AA8</Color>
        <Color x:Key="ReadyGpuColor">#10B981</Color>
        <Color x:Key="ReadyCpuColor">#3B82F6</Color>
        <Color x:Key="RecordingColor">#EF4444</Color>
        <Color x:Key="LoadingColor">#F59E0B</Color>

        <!-- Custom Style for ComboBoxItem -->
        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A122E"/>
            <Setter Property="Foreground" Value="#F3F0FC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5CF6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton Template for ComboBox -->
        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <!-- Arrow -->
                                <Path x:Name="Arrow" Grid.Column="1" Fill="#9E9AA8" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="border" Property="Background" Value="#251C3E"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="border" Property="Background" Value="#251C3E"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Style for ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161127"/>
            <Setter Property="BorderBrush" Value="#3B2A66"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="true" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#1A122E" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="2">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <ToggleButton x:Name="toggleButton" Grid.ColumnSpan="2"
                                          Style="{StaticResource ComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="0" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsHitTestVisible="false"/>
                            
                            <!-- Custom TextBox when ComboBox is editable -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" HorizontalAlignment="Stretch" Margin="8,3,8,3"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                     Visibility="Hidden" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" CaretBrush="#FFFFFF"
                                     FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Style for Buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A78BFA"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D283E"/>
                                <Setter Property="Foreground" Value="#6E6A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Flat Button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2D283E"/>
            <Setter Property="Foreground" Value="#F3F0FC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="#3B2A66" 
                                BorderThickness="1" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B2A66"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A1E4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Form / Configurations -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Status Indicator Panel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="WhisperTyper" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Local push-to-talk GPU speech typing assistant" FontSize="11" Foreground="#9E9AA8" Margin="2,2,0,0"/>
            <Border BorderThickness="0,0,0,1" BorderBrush="#2D283E" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Row 1: Configurations -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,15,0">
                
                <!-- Model Section -->
                <TextBlock Text="Whisper GGML Model File (.bin)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboModelPath" Grid.Column="0" IsEditable="True" ToolTip="Select a suggested model or type path" SelectionChanged="ComboModelPath_SelectionChanged"/>
                    <Button x:Name="BtnBrowseModel" Content="Browse..." Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseModel_Click"/>
                </Grid>

                <!-- Two-Column Layout for GPU and Language -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Graphic Card (GPU) -->
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Inference Device / GPU" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboGpu" SelectionChanged="ConfigChanged_TriggerEagerLoad"/>
                    </StackPanel>

                    <!-- Right: Language -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Target Language" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboLanguage" SelectionChanged="ConfigChanged_TriggerEagerLoad"/>
                    </StackPanel>
                </Grid>

                <!-- Two-Column Layout for Mic and Hotkey -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Microphone -->
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Recording Microphone" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboMic"/>
                    </StackPanel>

                    <!-- Right: Hotkey -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hold-to-Record Hotkey" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboHotkey" SelectionChanged="ComboHotkey_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Instructions Tip Box -->
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Instructions:" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6"/>
                        <TextBlock Text="1. Choose your model, GPU, microphone, and language." FontSize="10" Foreground="#9E9AA8" Margin="0,2,0,0"/>
                        <TextBlock Text="2. Select a hotkey and hold it. Speak into the microphone." FontSize="10" Foreground="#9E9AA8" Margin="0,2,0,0"/>
                        <TextBlock Text="3. Release the key. The text will type automatically at your cursor." FontSize="10" Foreground="#9E9AA8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Transcription Output Panel -->
                <TextBlock Text="Transcription History &amp; Diagnostics" FontSize="12" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#D1CFCF"/>
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>
                        <!-- Top bar of the history panel -->
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="Recent Logs" FontSize="10" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearHistory" Content="Clear Logs" HorizontalAlignment="Right" FontSize="9" Padding="6,1" Height="18" Style="{StaticResource SecondaryButton}" Click="BtnClearHistory_Click"/>
                        </Grid>
                        <!-- Log list -->
                        <TextBox x:Name="TxtHistory" Grid.Row="1" Background="#0E0B16" Foreground="#F3F0FC" BorderBrush="#2D283E" BorderThickness="1"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Padding="5"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Status Indicator Panel -->
        <Border Grid.Row="2" Background="#161127" BorderBrush="#2D283E" BorderThickness="1" CornerRadius="8" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Glow Indicator -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Status Outer Ring (Ripples when recording) -->
                    <Ellipse x:Name="StatusOuterRing" Width="20" Height="20" StrokeThickness="2" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RingScale" CenterX="10" CenterY="10"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Status Glow Circle -->
                    <Ellipse x:Name="StatusCircle" Width="12" Height="12" Fill="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <BlurEffect x:Name="StatusBlur" Radius="8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <!-- Status Text and Message -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready (GPU Mode)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubStatus" Text="Hold Caps Lock to type speech" FontSize="11" Foreground="#9E9AA8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Options / Close Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnReload" Content="Reload" Style="{StaticResource SecondaryButton}" Click="BtnReload_Click" Margin="0,0,8,0" Height="28" Padding="10,0"/>
                    <Button x:Name="BtnMinimize" Content="Hide to Tray" Style="{StaticResource ModernButton}" Click="BtnMinimize_Click" Height="28" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
