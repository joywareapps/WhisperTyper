<Window x:Class="WhisperTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WhisperTyper" Height="800" Width="755"
        Icon="App.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0E0B16"
        Foreground="#F3F0FC"
        FontFamily="Segoe UI"
        BorderThickness="0"
        ResizeMode="CanMinimize"> <!-- Optional icon -->

    <Window.Resources>
        <!-- Custom Color Palette -->
        <Color x:Key="BgColor">#0E0B16</Color>
        <Color x:Key="PanelColor">#1A122E</Color>
        <Color x:Key="AccentColor">#8B5CF6</Color>
        <Color x:Key="MutedColor">#9E9AA8</Color>
        <Color x:Key="ReadyGpuColor">#10B981</Color>
        <Color x:Key="ReadyCpuColor">#3B82F6</Color>
        <Color x:Key="RecordingColor">#EF4444</Color>
        <Color x:Key="LoadingColor">#F59E0B</Color>

        <!-- Custom Style for ComboBoxItem -->
        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A122E"/>
            <Setter Property="Foreground" Value="#F3F0FC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5CF6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton Template for ComboBox -->
        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <!-- Arrow -->
                                <Path x:Name="Arrow" Grid.Column="1" Fill="#9E9AA8" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="border" Property="Background" Value="#251C3E"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="border" Property="Background" Value="#251C3E"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Style for ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161127"/>
            <Setter Property="BorderBrush" Value="#3B2A66"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="true" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#1A122E" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="2">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <ToggleButton x:Name="toggleButton" Grid.ColumnSpan="2"
                                          Style="{StaticResource ComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="0" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsHitTestVisible="false"/>
                            
                            <!-- Custom TextBox when ComboBox is editable -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" HorizontalAlignment="Stretch" Margin="8,3,8,3"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                     Visibility="Hidden" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" CaretBrush="#FFFFFF"
                                     FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Style for Buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A78BFA"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D283E"/>
                                <Setter Property="Foreground" Value="#6E6A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Flat Button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2D283E"/>
            <Setter Property="Foreground" Value="#F3F0FC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="#3B2A66" 
                                BorderThickness="1" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B2A66"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A1E4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Form / Configurations -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Status Indicator Panel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="WhisperTyper" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Local push-to-talk GPU speech typing assistant" FontSize="11" Foreground="#9E9AA8" Margin="2,2,0,0"/>
            <Border BorderThickness="0,0,0,1" BorderBrush="#2D283E" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Row 1: Configurations -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,15,0">
                
                <!-- Model Section -->
                <TextBlock Text="Whisper GGML Model File (.bin)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboModelPath" Grid.Column="0" IsEditable="True" ToolTip="Select a suggested model or type path" SelectionChanged="ComboModelPath_SelectionChanged"/>
                    <Button x:Name="BtnBrowseModel" Content="Browse..." Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnBrowseModel_Click"/>
                </Grid>

                <!-- Model Manager -->
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                    <Expander x:Name="ExpanderModels" Foreground="#D1CFCF" Padding="10,8">
                        <Expander.Header>
                            <TextBlock Text="Model Manager" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,4">
                            <ItemsControl x:Name="ModelCatalogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#F3F0FC" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Notes}" FontSize="9" Foreground="#9E9AA8"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="10"
                                                       Foreground="#6B6878" VerticalAlignment="Center"/>
                                            <!-- Progress bar: only while downloading -->
                                            <ProgressBar x:Name="DlProgress" Grid.Column="2" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                                         Height="4" VerticalAlignment="Center" Margin="6,0"
                                                         Foreground="#8B5CF6" Background="#2D283E" BorderThickness="0"
                                                         Visibility="Collapsed"/>
                                            <!-- Action buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button x:Name="BtnDownload" Content="Download" Tag="{Binding}" Click="ModelDownload_Click"
                                                        Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                        Visibility="Collapsed"/>
                                                <Button x:Name="BtnLoad" Content="Load" Tag="{Binding}" Click="ModelLoad_Click"
                                                        Style="{StaticResource ModernButton}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                        Visibility="Collapsed"/>
                                                <Button x:Name="BtnDelete" Content="🗑" Tag="{Binding}" Click="ModelDelete_Click"
                                                        Style="{StaticResource SecondaryButton}" Height="24" Padding="6,0" FontSize="12"
                                                        Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Grid.Style><Style TargetType="Grid"/></Grid.Style>
                                            <Grid.Triggers/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- NotDownloaded: show Download only -->
                                            <DataTrigger Binding="{Binding Status}" Value="NotDownloaded">
                                                <Setter TargetName="BtnDownload" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <!-- Downloading: show progress bar + Cancel button -->
                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                <Setter TargetName="DlProgress"  Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnDownload" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnDownload" Property="Content"    Value="Cancel"/>
                                            </DataTrigger>
                                            <!-- Downloaded: show Load + Delete -->
                                            <DataTrigger Binding="{Binding Status}" Value="Downloaded">
                                                <Setter TargetName="BtnLoad"   Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnDelete" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <!-- Loaded: show Delete only (already loaded, no re-load needed) -->
                                            <DataTrigger Binding="{Binding Status}" Value="Loaded">
                                                <Setter TargetName="BtnLoad"   Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnLoad"   Property="IsEnabled"  Value="False"/>
                                                <Setter TargetName="BtnDelete" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnDelete" Property="IsEnabled"  Value="False"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtModelsDir" FontSize="9" Foreground="#6B6878" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Two-Column Layout for GPU and Language -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Graphic Card (GPU) -->
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Inference Device / GPU" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboGpu" SelectionChanged="ConfigChanged_TriggerEagerLoad"/>
                    </StackPanel>

                    <!-- Right: Language -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Target Language" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboLanguage" SelectionChanged="ConfigChanged_TriggerEagerLoad"/>
                    </StackPanel>
                </Grid>

                <!-- Two-Column Layout for Mic and Hotkey -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Microphone -->
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Recording Microphone" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboMic"/>
                    </StackPanel>

                    <!-- Right: Hotkey -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hold-to-Record Hotkey" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#D1CFCF"/>
                        <ComboBox x:Name="ComboHotkey" SelectionChanged="ComboHotkey_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Instructions Tip Box -->
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Instructions:" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6"/>
                        <TextBlock Text="1. Choose your model, GPU, microphone, and language." FontSize="10" Foreground="#9E9AA8" Margin="0,2,0,0"/>
                        <TextBlock Text="2. Select a hotkey and hold it. Speak into the microphone." FontSize="10" Foreground="#9E9AA8" Margin="0,2,0,0"/>
                        <TextBlock Text="3. Release the key. The text will type automatically at your cursor." FontSize="10" Foreground="#9E9AA8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Settings Checkboxes -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="ChkStartup" Content="Start with Windows"
                              Foreground="#D1CFCF" FontSize="11" Margin="0,0,20,0"
                              Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"/>
                    <CheckBox x:Name="ChkCopyToClipboard" Content="Always Copy to Clipboard"
                              Foreground="#D1CFCF" FontSize="11"
                              Checked="ChkCopyToClipboard_Changed" Unchecked="ChkCopyToClipboard_Changed"/>
                </StackPanel>

                <!-- Filler Word Removal -->
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0">
                    <Expander x:Name="ExpanderFiller" Foreground="#D1CFCF" Padding="10,8">
                        <Expander.Header>
                            <CheckBox x:Name="ChkFillerEnabled" Content="Filler Word Removal"
                                      Foreground="#D1CFCF" FontSize="12" FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      Checked="FillerEnabled_Changed" Unchecked="FillerEnabled_Changed"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <!-- Chip list -->
                            <ItemsControl x:Name="FillerWordsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D283E" BorderBrush="#3B2A66" BorderThickness="1"
                                                CornerRadius="10" Margin="0,3,5,3" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="11" Foreground="#F3F0FC"/>
                                                <Button Content="×" Tag="{Binding}" Click="RemoveFillerWord_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#9E9AA8" FontSize="14" Padding="4,0,0,1"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Add + Reset row -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewFillerWord" Grid.Column="0"
                                         Background="#0E0B16" Foreground="#FFFFFF" BorderBrush="#3B2A66"
                                         BorderThickness="1" Height="28" Padding="8,4"
                                         FontSize="11" VerticalContentAlignment="Center"
                                         KeyDown="FillerWordTextBox_KeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Add word or phrase…" Foreground="#555" FontSize="11" Margin="8,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="1" Content="Add" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0"
                                        Click="AddFillerWord_Click"/>
                                <Button Grid.Column="2" Content="Reset defaults" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0"
                                        Click="ResetFillerWords_Click"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Custom Dictionary -->
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
                    <Expander x:Name="ExpanderDict" Foreground="#D1CFCF" Padding="10,8">
                        <Expander.Header>
                            <TextBlock Text="Custom Dictionary" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <!-- Column headers -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Whisper hears…" FontSize="10" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Replace with" FontSize="10" Foreground="#8B5CF6" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </Grid>
                            <!-- Built-in: period spacing fix -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="sentence.Next" IsReadOnly="True"
                                         Background="#1E1A30" Foreground="#6B6878" BorderBrush="#2D283E"
                                         BorderThickness="1" Height="26" Padding="6,3" FontSize="11" FontStyle="Italic"/>
                                <TextBox Grid.Column="1" Text="sentence. Next" IsReadOnly="True"
                                         Background="#1E1A30" Foreground="#6B6878" BorderBrush="#2D283E"
                                         BorderThickness="1" Height="26" Padding="6,3" FontSize="11" FontStyle="Italic"
                                         Margin="6,0,6,0"/>
                                <CheckBox x:Name="ChkPeriodSpacing" Grid.Column="2"
                                          IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          ToolTip="Add space after period when missing (e.g. &quot;one.Two&quot; → &quot;one. Two&quot;)"
                                          Checked="PeriodSpacing_Changed" Unchecked="PeriodSpacing_Changed"/>
                            </Grid>
                            <!-- Rows -->
                            <ItemsControl x:Name="DictItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Trigger, UpdateSourceTrigger=LostFocus}"
                                                     Background="#0E0B16" Foreground="#FFFFFF" BorderBrush="#3B2A66"
                                                     BorderThickness="1" Height="26" Padding="6,3" FontSize="11"
                                                     LostFocus="DictEntry_Changed"/>
                                            <TextBox Grid.Column="1" Text="{Binding Replacement, UpdateSourceTrigger=LostFocus}"
                                                     Background="#0E0B16" Foreground="#FFFFFF" BorderBrush="#3B2A66"
                                                     BorderThickness="1" Height="26" Padding="6,3" FontSize="11"
                                                     Margin="6,0,6,0" LostFocus="DictEntry_Changed"/>
                                            <Button Grid.Column="2" Content="×" Tag="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Height="26" Padding="4,0"
                                                    FontSize="14" Click="RemoveDictEntry_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Add row -->
                            <Button Content="+ Add Entry" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryButton}" Height="26" Padding="12,0"
                                    Click="AddDictEntry_Click"/>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- History + Diagnostics Tabs -->
                <Border Background="#161127" BorderBrush="#3B2A66" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" Padding="10">
                    <StackPanel>
                        <!-- Tab header row -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TabHistory" Content="History" IsChecked="True"
                                              Checked="TabHistory_Checked" Height="26" Padding="12,0"
                                              FontSize="11" FontWeight="SemiBold"
                                              Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#2D283E"/>
                                            <Setter Property="Foreground" Value="#9E9AA8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#8B5CF6"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#3B2A66"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ToggleButton x:Name="TabDiag" Content="Diagnostics" Margin="4,0,0,0"
                                              Checked="TabDiag_Checked" Height="26" Padding="12,0" FontSize="11" FontWeight="SemiBold">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#2D283E"/>
                                            <Setter Property="Foreground" Value="#9E9AA8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#8B5CF6"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#3B2A66"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnSearchHistory" Content="🔍" Style="{StaticResource SecondaryButton}"
                                        Height="26" Padding="8,0" FontSize="11" Click="BtnSearchHistory_Click"/>
                                <Button x:Name="BtnClearPanel" Content="Clear" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0"
                                        FontSize="11" Click="BtnClearPanel_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Search box (hidden by default) -->
                        <TextBox x:Name="TxtHistorySearch" Visibility="Collapsed" Margin="0,0,0,8"
                                 Background="#0E0B16" Foreground="#FFFFFF" BorderBrush="#3B2A66" BorderThickness="1"
                                 Height="28" Padding="8,4" FontSize="11"
                                 TextChanged="TxtHistorySearch_TextChanged"/>

                        <!-- History panel -->
                        <Grid x:Name="PanelHistory" Height="160">
                            <ListBox x:Name="HistoryList" Background="#0E0B16" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="HistoryList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#F3F0FC"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A122E"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#2D1E5A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#F3F0FC"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                                <TextBlock FontSize="9" Foreground="#6B6878" Margin="0,2,0,0">
                                                    <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm  dd MMM}'}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding ModelName}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="📋" Tag="{Binding}" Click="HistoryCopy_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#9E9AA8" FontSize="12" Padding="4,2" Cursor="Hand"
                                                        ToolTip="Copy to clipboard"/>
                                                <Button Content="⌨" Tag="{Binding}" Click="HistoryRetype_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#9E9AA8" FontSize="12" Padding="4,2" Cursor="Hand"
                                                        ToolTip="Re-type at cursor"/>
                                                <Button Content="🗑" Tag="{Binding}" Click="HistoryDelete_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#9E9AA8" FontSize="12" Padding="4,2" Cursor="Hand"
                                                        ToolTip="Delete entry"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Diagnostics panel -->
                        <TextBox x:Name="TxtHistory" Visibility="Collapsed" Height="160"
                                 Background="#0E0B16" Foreground="#F3F0FC" BorderBrush="#2D283E" BorderThickness="1"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Padding="5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Status Indicator Panel -->
        <Border Grid.Row="2" Background="#161127" BorderBrush="#2D283E" BorderThickness="1" CornerRadius="8" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Glow Indicator -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Status Outer Ring (Ripples when recording) -->
                    <Ellipse x:Name="StatusOuterRing" Width="20" Height="20" StrokeThickness="2" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RingScale" CenterX="10" CenterY="10"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Status Glow Circle -->
                    <Ellipse x:Name="StatusCircle" Width="12" Height="12" Fill="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <BlurEffect x:Name="StatusBlur" Radius="8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <!-- Status Text and Message -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready (GPU Mode)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubStatus" Text="Hold Caps Lock to type speech" FontSize="11" Foreground="#9E9AA8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Options / Close Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnReload" Content="Reload" Style="{StaticResource SecondaryButton}" Click="BtnReload_Click" Margin="0,0,8,0" Height="28" Padding="10,0"/>
                    <Button x:Name="BtnMinimize" Content="Hide to Tray" Style="{StaticResource ModernButton}" Click="BtnMinimize_Click" Height="28" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
